    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"fact_loan\", \"dim_grade\", \"dim_date\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
